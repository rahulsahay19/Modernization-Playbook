{
  "Service": {
    "Name": "DocumentsService",
    "Description": "Extracted claim document intake and verification service."
  },
  "ConnectionStrings": {
    "DocumentsDatabase": "Data Source=.local-data/documents-service/documents.db"
  },
  "IntegrationEventBroker": {
    "QueueDirectory": ".local-broker/document-events",
    "PublishIntervalSeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
