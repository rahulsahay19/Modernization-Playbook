{
  "Gateway": {
    "Routes": [
      {
        "RouteId": "platform-modules",
        "Capability": "Platform metadata",
        "PathPrefix": "/api/platform",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "The gateway can expose platform metadata while the modular monolith remains the owner."
      },
      {
        "RouteId": "claims",
        "Capability": "Claims",
        "PathPrefix": "/api/claims",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Claims stay in the modular monolith until their workflow and contracts stabilize."
      },
      {
        "RouteId": "documents",
        "Capability": "Documents",
        "PathPrefix": "/api/documents",
        "UpstreamName": "DocumentsService",
        "DestinationBaseUrl": "http://localhost:5240",
        "Extracted": true,
        "RoutePurpose": "Documents is the first real extracted service behind the Strangler gateway."
      },
      {
        "RouteId": "payments",
        "Capability": "Payments",
        "PathPrefix": "/api/payments",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Payments remain behind the gateway until settlement and provider contracts are explicit."
      },
      {
        "RouteId": "reference-data",
        "Capability": "Policy, membership, and provider reference data",
        "PathPrefix": "/api/policies",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Reference modules stay together for now; each can be split later without changing the frontend."
      },
      {
        "RouteId": "members",
        "Capability": "Membership",
        "PathPrefix": "/api/members",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Membership is routed independently so it can become its own service later."
      },
      {
        "RouteId": "providers",
        "Capability": "Provider network",
        "PathPrefix": "/api/providers",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Provider network can be moved behind the same route when extracted."
      },
      {
        "RouteId": "notifications",
        "Capability": "Communications",
        "PathPrefix": "/api/notifications",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Communications remains event-driven and can be extracted after a broker is introduced."
      },
      {
        "RouteId": "audit",
        "Capability": "Audit",
        "PathPrefix": "/api/audit",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Audit is a cross-cutting read model that remains internal for this stage."
      },
      {
        "RouteId": "reporting",
        "Capability": "Reporting",
        "PathPrefix": "/api/reports",
        "UpstreamName": "ModularMonolith",
        "DestinationBaseUrl": "http://localhost:5220",
        "Extracted": false,
        "RoutePurpose": "Reporting proves the gateway can route read models without frontend changes."
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
